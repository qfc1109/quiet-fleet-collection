# This template contains no real secret. bootstrap.sh generates /etc/qfc/qfc.env with mode 0600.
QFC_MYSQL_HOST=127.0.0.1
QFC_MYSQL_PORT=3306
QFC_MYSQL_USERNAME=qfc_app
QFC_MYSQL_PASSWORD=replace-with-generated-password
QFC_MYSQL_IMAGE=mysql:8.0
QFC_REDIS_HOST=127.0.0.1
QFC_REDIS_PORT=6379
QFC_REDIS_PASSWORD=replace-with-generated-password
QFC_REDIS_IMAGE=redis:7-alpine
QFC_JWT_SECRET=replace-with-generated-secret
